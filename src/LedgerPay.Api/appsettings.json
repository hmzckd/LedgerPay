{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Ledger": "Host=localhost;Port=5435;Database=ledgerpay;Username=ledgerpay;Password=ledgerpay",
    "RabbitMq": "amqp://ledgerpay:ledgerpay@localhost:5672/"
  },
  "Outbox": {
    "RelayEnabled": true
  },
  "Reconciliation": {
    "ScheduleEnabled": true,
    "RunAt": "00:05"
  },
  "Risk": {
    "Address": "http://localhost:5082"
  },
  "Tracing": {
    "ExportEnabled": true
  }
}
